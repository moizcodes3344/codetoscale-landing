{
  "name": "codetoscale-website",
  "version": "1.0.0",
  "private": true,
  "description": "CodeToScale static corporate website",
  "type": "module",
  "scripts": {
    "dev": "node serve.mjs",
    "start": "node serve.mjs",
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs --production",
    "audit:seo": "node scripts/audit.mjs",
    "check": "node --check script.js && node --check navigation.js && node --check serve.mjs && node --test tests/*.test.mjs"
  },
  "engines": { "node": ">=20" }
}
